# ===== フロント（Vite / Vercel）→ .env.local にコピー =====
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_LINE_LIFF_ID=1234567890-abcdefgh

# ===== Supabase Edge secrets（supabase secrets set / Dashboard）=====
# .env.local には入れない。日次締めグループ push + 顧客 userId push + LIFF/Webhook 用。
LINE_CHANNEL_ACCESS_TOKEN=xxxxx
LINE_GROUP_ID=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_CHANNEL_SECRET=your_channel_secret
LINE_LIFF_ID=1234567890-abcdefgh
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
CRON_SECRET=your_random_cron_secret
RESEND_API_KEY=re_xxxxxxxx
ALERT_EMAIL_FROM=notifications@your-verified-domain.com
ALERT_EMAIL_TO=admin@example.com

# ===== 任意: supabase link / db =====
# SUPABASE_DB_PASSWORD=your_db_password
