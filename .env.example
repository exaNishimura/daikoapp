VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# ローカル開発・Vite ビルド・Vercel Functions で共用（Places 表示にも使用）
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Vercel 本番の Directions プロキシ (api/google-maps/directions/json.js) でも参照される

# 日次締め / LINE受注（Supabase Edge Function のシークレットに設定）
LINE_CHANNEL_ACCESS_TOKEN=xxxxx
LINE_GROUP_ID=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook 署名検証・LIFF（line-webhook / line-intake-api が参照）
LINE_CHANNEL_SECRET=your_channel_secret
LINE_LIFF_ID=1234567890-abcdefgh
# Edge から Directions を直呼び（Vite proxy 非依存）
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
CRON_SECRET=your_random_cron_secret

# フロント（LIFF ページ）
VITE_LINE_LIFF_ID=1234567890-abcdefgh

# LINE 送信失敗時のメール通知（Resend）
RESEND_API_KEY=re_xxxxxxxx
ALERT_EMAIL_FROM=notifications@your-verified-domain.com
ALERT_EMAIL_TO=admin@example.com